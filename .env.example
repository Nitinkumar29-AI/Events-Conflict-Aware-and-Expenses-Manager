# ==============================================================================
# ACM Incursion — Conflict-Aware Events & Expenses Manager
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE REQUIRED CONFIGURATION (MANDATORY IN ALL ENVIRONMENTS)
# ------------------------------------------------------------------------------

# PostgreSQL Connection String (must start with postgresql:// or postgres://)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acm_incursion?schema=public"

# Node Environment ('development' | 'test' | 'production')
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------

# Secret key used for signing JWT session tokens.
# IN PRODUCTION: MUST be at least 32 characters long.
# Generate via: openssl rand -base64 32
AUTH_SECRET="your-secure-32-character-random-secret-key-goes-here!"

# Canonical Public URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application operational timezone (informational: canonical DB timestamps are ALWAYS UTC)
TZ_APP="Asia/Kolkata"

# ------------------------------------------------------------------------------
# 3. OPTIONAL SINGLE SIGN-ON (GOOGLE OAUTH)
# ------------------------------------------------------------------------------
# If either is configured, BOTH GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET must be set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional institutional domain restriction for OAuth callbacks (e.g. '@college.edu')
# Users with non-matching domains will be rejected during login callback.
ALLOWED_EMAIL_DOMAIN="@college.edu"

# ------------------------------------------------------------------------------
# 4. OPTIONAL CLOUD STORAGE (CLOUDINARY)
# ------------------------------------------------------------------------------
# If provided, all three variables are required for signed receipt asset uploads.
# In local dev / demo mode without credentials, a built-in mock service handles
# receipt metadata storage and client SHA-256 verification cleanly.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
